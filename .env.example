# Smart Route Planner - Environment Configuration

# ==============================================================================
# Google Maps Platform Credentials (Google Cloud Console)
# ==============================================================================
# 1. Frontend Browser Key:
#    - Restricted in Google Cloud Console to HTTP referrers (e.g. http://localhost:*/*, http://127.0.0.1:*/*)
#    - Used for Google Maps JavaScript API and frontend place autocomplete
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here

# 2. Backend Server Key:
#    - Restricted in Google Cloud Console to IP addresses or unrestricted
#    - Used by Python Flask backend for Routes API, Directions API, and Geocoding API
#    - SECURITY NOTICE: This server key is NEVER exposed in HTML or client JavaScript
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# Fallback legacy variable (optional, used if only a single unrestricted key is provided)
GOOGLE_MAPS_API_KEY=

# ==============================================================================
# Application Configuration
# ==============================================================================
PORT=5000
SECRET_KEY=smart-route-planner-academic-secret-key-2026
